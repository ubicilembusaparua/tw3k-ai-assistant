# OpenAI is used for grounded answer generation only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local embedding and reranking models.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Local Qdrant service.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tw3k_transcripts

# Retrieval defaults. These values must be backed by evaluation results before
# the retrieval implementation is considered complete.
RETRIEVAL_CANDIDATE_COUNT=20
FINAL_CONTEXT_COUNT=8
CONTEXT_TOKEN_BUDGET=4000
RELEVANCE_THRESHOLD=0.35
