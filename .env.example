# Copy this file to .env and replace the placeholders before starting Compose.
# Never commit .env or put credentials in Docker build arguments/layers.

# Consumed at runtime by app. This placeholder is intentionally not usable.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Consumed by app. This host-facing port is also passed to Streamlit inside the
# container. Use a decimal TCP port from 1 through 65535.
STREAMLIT_PORT=8501

# Consumed by PostgreSQL, db_init.py, db_save.py, db_query.py, db_feedback.py,
# and the optional seed script. The service name resolves only on the Compose
# network; use localhost or another reachable host for a non-Compose override.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tw3k_monitoring
POSTGRES_USER=tw3k
POSTGRES_PASSWORD=change-this-local-password

# Consumed by the app retrieval client and ingest_qdrant.py. qdrant resolves
# only on the Compose network; use a reachable URL for a non-Compose override.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tw3k_transcripts

# Consumed by ingest_qdrant.py. QDRANT_BATCH_SIZE must be a positive decimal
# integer. QDRANT_FORCE_REINDEX accepts true or false (case-insensitive) and
# defaults to the non-destructive value false.
QDRANT_BATCH_SIZE=64
QDRANT_FORCE_REINDEX=false

# Consumed by scripts/download.py and the ONNX Embedder. This repository
# default is downloaded into the shared /app/models volume by Compose.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
